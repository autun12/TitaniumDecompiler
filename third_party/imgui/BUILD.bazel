load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "objc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "imgui_core",
    srcs = [
        "imgui.cpp",
        "imgui_demo.cpp",
        "imgui_draw.cpp",
        "imgui_tables.cpp",
        "imgui_widgets.cpp",
    ],
    hdrs = glob([
        "*.h",
        "imconfig.h",
        "imgui.h",
        "imgui_internal.h",
        "imstb_rectpack.h",
        "imstb_textedit.h",
        "imstb_truetype.h",
    ]),
    includes = ["."],
    visibility = ["//visibility:private"],
)

objc_library(
    name = "imgui_metal_backend",
    srcs = [
        "backends/imgui_impl_metal.mm",
    ],
    hdrs = [
        "backends/imgui_impl_metal.h",
    ],
    copts = [
        "-fno-objc-arc",
    ],
    includes = ["backends"],
    visibility = ["//visibility:private"],
    deps = [
        ":imgui_core",
        "@Metal//:metal",
    ],
    alwayslink = True,
)

cc_library(
    name = "imgui_glfw_backend",
    srcs = [
        "backends/imgui_impl_glfw.cpp",
    ],
    hdrs = [
        "backends/imgui_impl_glfw.h",
    ],
    includes = ["backends"],
    visibility = ["//visibility:private"],
    deps = [
        ":imgui_core",
        "@GLFW//:glfw",
    ],
    alwayslink = True,
)

cc_library(
    name = "imgui",
    hdrs = select({
        "@platforms//os:windows": [
            "backends/imgui_impl_dx11.h",
            "backends/imgui_impl_glfw.h",
            "backends/imgui_impl_opengl3.h",
            "backends/imgui_impl_win32.h",
        ],
        "@platforms//os:linux": [
            "backends/imgui_impl_glfw.h",
            "backends/imgui_impl_opengl3.h",
        ],
        "@platforms//os:macos": [
            "backends/imgui_impl_glfw.h",
            "backends/imgui_impl_metal.h",
        ],
    }) + glob(["*.h"]),
    includes = [
        ".",
        "backends",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":imgui_core",
        ":imgui_glfw_backend",
    ] + select({
        "@platforms//os:macos": [
            ":imgui_metal_backend",
        ],
        "//conditions:default": [],
    }),
)

objc_library(
    name = "imgui-metal-demo-lib",
    srcs = ["examples/example_glfw_metal/main.mm"],
    sdk_frameworks = [
        "Metal",
        "MetalKit",
        "Cocoa",
        "IOKit",
        "CoreVideo",
        "QuartzCore",
    ],
    deps = [
        # Include your imgui library and glfw dependencies here
        ":imgui",
        # "@glfw//:glfw",
    ],
)

cc_binary(
    name = "imgui-metal-demo",
    deps = [
        ":imgui-metal-demo-lib",
    ],
)

