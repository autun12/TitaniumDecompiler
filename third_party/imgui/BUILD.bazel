load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "objc_library")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "imgui-metal-demo",
    srcs = [
        "examples/example_glfw_metal/main.cpp",
    ],
    deps = [
        "@imguilib//:imgui",
        "@GLFW//:glfw",
        "@metal//:metal",
    ],
    linkopts = [
        "-framework Cocoa",
        "-framework IOKit",
        "-framework CoreFoundation",
    ],
)

cc_binary(
    name = "imgui-glfw-demo",
    srcs = [
        "examples/example_glfw_opengl3/main.cpp",
    ],
    deps = [
        "@imguilib//:imgui",
        "@GLAD//:glad",
        "@GLFW//:glfw",
    ]
)

objc_library(
    name = "imgui_metal",
    srcs = glob([
        "backends/imgui_impl_metal*",
        "backends/imgui_impl_glfw*",
        "*.mm",
        "*.h",
    ]),
    hdrs = glob([
        "backends/imgui_impl_metal.h",
        "backends/imgui_impl_glfw.h",
        "*.h",
    ]),
    visibility = [
        "//visibility:private",
    ],
    deps = [
        "@GLFW//:glfw",
        "@metal//:metal",
    ],
)

cc_library(
    name = "imgui",
    srcs = select(
        {
            "@platforms//os:windows": glob([
                "backends/imgui_impl_win32*",
                "backends/imgui_impl_dx11*",
                "backends/imgui_impl_opengl3*",
                "backends/imgui_impl_glfw*",
                "*.cpp",
                "*.h",
            ]),
            "@platforms//os:linux": glob([
                "backends/imgui_impl_opengl3*",
                "backends/imgui_impl_glfw*",
                "*.cpp",
                "*.h",
            ]),
            "@platforms//os:macos": glob([
            ]),
        },
    ),
    hdrs = select(
        {
            "@platforms//os:windows": [
                "backends/imgui_impl_win32.h",
                "backends/imgui_impl_dx11.h",
                "backends/imgui_impl_opengl3.h",
                "backends/imgui_impl_glfw.h",
            ] + glob(["*.h"]),
            "@platforms//os:linux": [
                "backends/imgui_impl_opengl3.h",
                "backends/imgui_impl_glut.h",
                "backends/imgui_impl_glfw.h",
            ] + glob(["*.h"]),
            "@platforms//os:macos": [
            ],
        },
    ),
    includes = [
        "",
        "backends",
    ],
    deps = select({
        "@platforms//os:macos": [
            ":imgui_metal",
        ],
        "//conditions:default": [
            "@GLFW//:glfw",
        ],
    }),
)