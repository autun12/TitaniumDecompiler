cc_binary(
    name = "imgui-glfw-demo",
    srcs = [
        "examples/example_glfw_opengl3/main.cpp",
    ],
    deps = [
        ":imgui",
        "@GLAD//:glad",
        "@GLFW//:glfw",
    ],
)

cc_library(
    name = "imgui_color_text_edit",
    srcs = ["TextEditor.cpp"],
    hdrs = ["TextEditor.h"],
    includes = ["."],
    deps = ["@imguilib//:imgui"],
    alwayslink = True,
)
