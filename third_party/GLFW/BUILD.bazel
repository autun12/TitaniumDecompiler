load("@rules_cc//cc:defs.bzl", "cc_library", "objc_library")

package(default_visibility = ["//visibility:public"])

objc_library(
    name = "glfw_cocoa",
    hdrs = [
        "include/GLFW/glfw3.h",
        "include/GLFW/glfw3native.h",
        "src/cocoa_joystick.h",
        "src/cocoa_platform.h",
        "src/internal.h",
        "src/platform.h",
        "src/posix_thread.h",
        "src/mappings.h",
        "src/null_platform.h",
        "src/cocoa_time.h",
        "src/null_joystick.h",
    ],
    srcs = [
        "src/cocoa_joystick.m",
        "src/nsgl_context.m",
        "src/cocoa_monitor.m",
        "src/cocoa_window.m",
        "src/cocoa_init.m",
        "src/posix_thread.c",
        "src/cocoa_time.c",
        "src/egl_context.c",
        "src/osmesa_context.c",
        "src/context.c",
        "src/init.c",
        "src/input.c",
        "src/vulkan.c",
        "src/window.c",
        "src/monitor.c",
    ],
    defines = [
        "_GLFW_COCOA",
    ],
    copts = [
        "-fno-objc-arc",
        "-Wno-incompatible-function-pointer-types",
    ],
    linkopts = [
        "-Wno-incompatible-function-pointer-types",
    ],
    visibility = [
        "//visibility:private",
    ],
)

cc_library(
    name = "glfw_src",
    srcs = [
        "src/context.c",
        "src/egl_context.c",
        "src/init.c",
        "src/input.c",
        "src/osmesa_context.c",
        "src/monitor.c",
        "src/vulkan.c",
        "src/window.c",
		"src/null_init.c",
		"src/null_joystick.c",
		"src/null_monitor.c",
		"src/null_window.c",
        "src/platform.c",
    ] + select({
        "@platforms//os:windows": [
            "src/win32_init.c",
            "src/win32_joystick.c",
            "src/win32_monitor.c",
            "src/win32_module.c",
            "src/win32_thread.c",
            "src/win32_time.c",
            "src/win32_window.c",
            "src/wgl_context.c",
        ],
        "@platforms//os:macos": [
            "src/cocoa_time.c",
            "src/posix_thread.c",
        ],
        "@platforms//os:linux": [
            "src/glx_context.c",
            "src/linux_joystick.c",
            "src/posix_thread.c",
            "src/posix_time.c",
            "src/posix_module.c",
            "src/x11_init.c",
            "src/x11_monitor.c",
            "src/x11_window.c",
            "src/xkb_unicode.c",
        ]
    }),
    hdrs = [
        "include/GLFW/glfw3.h",
        "include/GLFW/glfw3native.h",
        "src/internal.h",
        "src/mappings.h",
    ] + select({
        "@platforms//os:windows": [
            "src/win32_joystick.h",
            "src/win32_platform.h",
            "src/win32_time.h",
            "src/win32_thread.h",
            "src/null_platform.h",
            "src/null_joystick.h",
            "src/platform.h",
        ],
        "@platforms//os:macos": [
            "src/cocoa_time.h",
            "src/cocoa_joystick.h",
            "src/cocoa_platform.h",
            "src/null_joystick.h",
            "src/null_platform.h",
            "src/posix_thread.h",
            "src/wl_platform.h",
        ],
        "@platforms//os:linux": [
            "src/linux_joystick.h",
            "src/posix_thread.h",
            "src/posix_time.h",
            "src/x11_platform.h",
            "src/null_platform.h",
            "src/null_joystick.h",
            "src/platform.h",

        "src/xkb_unicode.h",
        ]
    }),
    defines = select({
        "@platforms//os:windows": [
            "_GLFW_WIN32",
        ],
        "@platforms//os:macos": [
            "_GLFW_COCOA",
            "_GLFW_NSGL",
            "_GLFW_NO_DLOAD_WINMM",
            "_GLFW_USE_OPENGL",
        ],
        "@platforms//os:linux": [
            "_GLFW_HAS_XF86VM",
            "_GLFW_X11",
        ],
    }),
    copts = select({
        "@platforms//os:macos": [
            "-Wno-incompatible-function-pointer-types",
        ],
        "@platforms//os:linux": [
            "-Wno-incompatible-function-pointer-types",
        ],
        "@platforms//os:windows": [
            "-Wno-incompatible-function-pointer-types",
            "-Wno-int-conversion",
            "-Wno-implicit-function-declaration",
            "-Wno-implicit-int",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:opengl32.lib",
            "-DEFAULTLIB:user32.lib",
            "-DEFAULTLIB:gdi32.lib",
            "-DEFAULTLIB:shell32.lib",
            "-DEFAULTLIB:Dwmapi.lib",
        ],
        "@platforms//os:macos": [
            "-framework OpenGL",
            "-framework Cocoa",
            "-framework IOKit",
            "-framework CoreFoundation",
        ],
        "@platforms//os:linux": [],
        "//conditions:default": [],
    }),
    deps = select({
        "@platforms//os:macos": [
            ":glfw_cocoa",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "glfw",
    hdrs = [
        "include/GLFW/glfw3.h",
        "include/GLFW/glfw3native.h",
    ],
    deps = [
        ":glfw_src",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
